# Acme for Mealie. Generated from the acme fixture; edit that, not this.
# Light mode = Day, dark mode = Night. Mealie reads these at startup; recreate the container after changes.
# Comments give the palette token and the contrast of the text Vuetify places on the fill.

# LIGHT: Acme Day
# cyan; app bar, filled buttons, active nav, brand; white text 5.51:1 AA
THEME_LIGHT_PRIMARY=#007197
# teal; secondary action buttons, chips, sidebar badge; white text 4.18:1 AA-large
THEME_LIGHT_ACCENT=#118c74
# yellow; meal-plan note button; white text 4.85:1 AA
THEME_LIGHT_SECONDARY=#8c6c3e
# green; success alerts and chips; white text 5.23:1 AA
THEME_LIGHT_SUCCESS=#587539
# teal; info alerts and chips; white text 4.18:1 AA-large
THEME_LIGHT_INFO=#118c74
# orange; warning alerts and chips; white text 4.77:1 AA
THEME_LIGHT_WARNING=#b15c00
# red; error alerts, destructive actions; white text 4.90:1 AA
THEME_LIGHT_ERROR=#c64343

# DARK: Acme Night
# cyan; app bar, filled buttons, active nav, brand; black text 12.24:1 AA
THEME_DARK_PRIMARY=#7dcfff
# teal; secondary action buttons, chips, sidebar badge; black text 12.61:1 AA
THEME_DARK_ACCENT=#73daca
# yellow; meal-plan note button; black text 10.50:1 AA
THEME_DARK_SECONDARY=#e0af68
# green; success alerts and chips; black text 11.49:1 AA
THEME_DARK_SUCCESS=#9ece6a
# teal; info alerts and chips; black text 12.61:1 AA
THEME_DARK_INFO=#73daca
# orange; warning alerts and chips; black text 10.33:1 AA
THEME_DARK_WARNING=#ff9e64
# red; error alerts, destructive actions; black text 9.28:1 AA
THEME_DARK_ERROR=#f79178
